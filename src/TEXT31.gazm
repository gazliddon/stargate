                FCB COLOR,$33,SUB
                FDB BKTSUB
                FCC "CLEARED"
                FCB 0

HSRESP:         FCB CURSAB,$2A,$40,0
                FCB COLOR,$88
                FCC "HIGH SCORE TABLE RESET"
                FCB 0

BKTSUB:         FCC " BOOKKEEPING TOTALS "
                FCB 0

AUDX1:          EQU $1C
AUDX2:          EQU $6C

A_PDC:          FCB CURSAB,AUDX1,$60,0
                FCC "PAID CREDITS"
                FCB CURSAB,AUDX2,$60,0,0

