                FCB 0

J_CUB:          FCB SUB
                FDB UNFOR
                FCC "BONUS CREDIT"
                FCB 0

J_MUN:          FCC "MINIMUM UNITS FOR ANY CREDIT"
                FCB 0

UNFOR:          FCC "UNITS REQUIRED FOR "
