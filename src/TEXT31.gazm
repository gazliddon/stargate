J_BOS:          FCC "DIFFICULTY ACCELERATION RATE"
                FCB 0

J_INV:          FCC "INVISO TIME PER SHIP"
                FCB 0

J_WRP:          FCC "MEN NEEDED TO WARP"
                FCB 0

J_LWRP:         FCC "LAST WAVE WARP ALLOWED"
                FCB 0

J_GODL:         FCC "LETTERS FOR"
                FCB SUB
                FDB HISCR
                FCB 0

HISCR:          FCC " HIGHEST SCORE NAME"
                FCB 0

J_FACS:         FCC "RESTORE"
                FCB SUB
                FDB FACSUB
                FCB 0

J_CAUD:         FCC "CLEAR"
