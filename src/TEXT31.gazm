                FCC "C"
                FCB RPAREN
                FCC " 1981 WILLIAMS ELECTRONICS INC"
                FCB PERIOD,0
INSUB:          FCB CURSAB,$30,$70,0
                FCC "INITIAL TESTS INDICATE"
                FCB COLON,0

OKMP:           FCB COLOR,$99,SUB
                FDB INSUB
                FCB CURSAB,$3A,$90,0
                FCC "ALL SYSTEMS GO"
                FCB 0

INERSB:         FCB COLOR,$22,SUB                 ; In red,
                FDB INSUB                         ; Initial tests indicate,
                FCB CURSAB,$40,$90,0,0            ; And set cursor for error

FDSUB:          FCB CURSAB,$40,$80,0
                FCB COLOR,$22
                FCB 0

FDROMP:         FCB SUB
                FDB FDSUB
                FCC "ROM"
                FCB SUB
                FDB ERRSUB
                FCB NUMB,0

FDRAMP:         FCB SUB
                FDB FDSUB
                FCC "RAM"
                FCB SUB
                FDB ERRSUB
                FCB NUMB,0

ROMERP:         FCB SUB
                FDB INERSB
                FCC "ROM"
                FCB SUB
                FDB ERRSUB
                FCB NUMB,0

RERRMP:         FCB SUB
                FDB INERSB
                FCC "RAM"
                FCB SUB
                FDB ERRSUB
                FCB NUMB,0

ERRSUB:         FCC " ERROR "
                FCB ZBLANK,0

CHSUB_local:
                FCB CURSAB,$3F,$70,0,COLOR,$DD
                FCB ZBLANK
                FCC " WAVE "
                FCB NUMB,COLON
                FCB 0

CHYLMP:         FCB SUB
                FDB CHSUB_local
                FCB COLOR,$AA
                FCB CURSAB,$32,$88,0
                FCC "YLLABIAN DOGFIGHT"
                FCB 0

CHFBMP:         FCB SUB
                FDB CHSUB_local
                FCB COLOR,$CC
                FCB CURSAB,$2E,$88,0
                FCC "FIREBOMBER SHOWDOWN"
                FCB 0

PROMP:          FCB COLOR,$55
                FCC "2000"
                FCB EXPT,0

FEWMP:          FCB COLOR,$FF,CURSAB
                FDB MESSUL+(11*256)
                FCB 0
                FCC " HUMANOIDS REMAINING"
                FCB COLON,SPACE,ZBLANK,NUMB,0

PODMP:          FCB COLOR,$88,CURSAB
                FDB MESSUL+(12*256)
                FCB 0
                FCC "POD INTERSECTION "
                FCB HYPHEN
                FCC " 0"
                FCB COLON,0


PODTMP:         FCB COLOR,$88,CURSAB
                FDB MESSUL+(49*256)
                FCB 0,NBLANK,NUMB,0

DEFMP:          FCB COLIND
                FDB SCNCOL
                FCB CURSAB
                FDB MESSUL+(20*256)
                FCB 0,ARROW
                FCC "  SCANNER  "
                FCB ARROW,0

TBLOMP:         FCB COLOR,$55,CURSAB
                FDB MESSUL+$A00
                FCB 0
                FCC "PLANET SURFACE UNSTABLE"
                FCB EXPT,0

LNDKLP:         FCB COLOR,$55,CURSAB
                FDB MESSUL+$C00
                FCB 0
                FCC "ALL LANDERS DESTROYED"
                FCB EXPT,0

NWARPP:         FCB COLOR,$77,CURSAB
                FDB MESSUL+$400
                FCB 0,ZBLANK,SUB
                FDB WRSUB
                FCB NUMB,SUB
                FDB ADSUB
                FCC "EN"
                FCB 0

WRSUB:          FCC "WARP REQUIRES "
                FCB 0

ADSUB:          FCC " ADDITIONAL M"
                FCB 0

NOWRPP:         FCB COLOR,$77,CURSAB
                FDB MESSUL+$400
