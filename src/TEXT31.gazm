                FCC "MORE ADJUSTMENTS"
                FCB CURSAB,$3D,$DE,0,COLOR,$33
                FCC "PRESS ADVANCE TO EXIT"
                FCB 0

UPDNSB:         FCC "USE UP"
                FCB HYPHEN
                FCC "DOWN LEVER TO SELECT "
                FCB 0

J_REP:          FCC "EXTRA SHIP EVERY"
                FCB 0

J_SHP:          FCB SUB
                FDB SHIP1
                FCC "1"
                FCB SUB
                FDB SHIP2
                FCB 0

SHIP1:          FCC "SHIPS FOR "
                FCB 0

SHIP2:          FCC " CREDIT GAME"
                FCB 0

