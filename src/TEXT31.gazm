                FCC "CONTROL"
                FCB 0

DIFC:           FCC " DIFFICULTY "
                FCB 0

J_IND:          FCC "INITIAL"
                FCB SUB
                FDB DIFC
                FCB 0

J_DCE:          FCC "MAXIMUM"
                FCB SUB
                FDB DIFC
                FCB 0

J_FBO:          FCC "1ST"
