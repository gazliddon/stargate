YLBONP:         FCB COLOR,$EE,CURSAB,$1C,$70,0
                FCC "YLLABIAN STARFLEET TERMINATED"
                FCB PERIOD,PERIOD,PERIOD,COLOR,$FF,CURSAB,$3C,$90,0
                FCC "2500"
                FCB SPACE,SPACE,COLOR,$DD
                FCC "B"
                FCB COLOR,$EE
                FCC "O"
                FCB COLOR,$FF
                FCC "N"
                FCB COLOR,$DD
                FCC "U"
                FCB COLOR,$EE
                FCC "S"
                FCB 0

FBBONP:         FCB COLOR,$FF,CURSAB,$28,$70,0
                FCC "FIREBOMBER STRIKEFORCE ANNIHILATED"
                FCB SPACE,EXPT,COLOR,$AA,CURSAB,$38,$90,0
                FCC "5000  BONUS"
                FCB 0

CENTRP:         FCB COLOR,$99,CURSAB,$13,$70,0
                FCC "CENTER THE LINE USING THRUST AND FIRE"
                FCB CURSAB,$1E,$7E,0
                FCC "PRESS ADVANCE WHEN CENTERED"
                FCB COLOR,$BB,SFONT,CURSAB,$4B,$50,0,ARROW
                FCB 0

OPMESP:         FCB COLOR,$BB,CURSAB,$2C,$16,0
                FCC "ATTRACT MODE MESSAGE"
                FCB SUB
                FDB TELSUB
                FCB 0

ONLY5P:         FCB COLOR,$BB,CURSAB,$20,$70,0
                FCC "5 ENTRIES MAXIMUM PER PLAYER"
                FCB CURSAB,$28,$90,1
                FCC "LOWEST ENTRY REPLACED"
                FCB 0

TELSUB:         FCB SFONT,COLOR,$33,CURSAB,$2C,$C0,0
                FCB SUB
                FDB UPDNSB
                FCC "LETTER"
                FCB CURSAB,$37,$CC,0
                FCC "USE FIRE TO ENTER LETTER"
                FCB COLOR,$44
                FDB 0

PRPLYR:         FCB CURSAB,$40,$10,$0
                FCC "PLAYER "
                FCB 0

GODMSP:         FCB COLOR,$BB,SUB
                FDB PRPLYR
                FCB ZBLANK,NUMY,CURSAB,$20,$28,0
                FCC "YOU HAVE JUST COMPLETED THE"
                FCB CURSAB,$25,$38,0
                FCC "GREATEST STARGATE MISSION"
                FCB CURSAB,$36,$58,0
                FCC "ENTER YOUR NAME"
                FCB CURSAB,$34,$68,0,LPAREN
                FCC "UP TO "
                FCB ZBLANK,NUMB
                FCC " LETTERS"
                FCB RPAREN,SUB
                FDB TELSUB
                FCB 0

CONGP:          FCB COLOR,$44,SUB
                FDB PRPLYR
                FCB ZBLANK,NUMB
                FCB CURSAB,$21,$2C,0
                FCC "YOU HAVE ENTERED THE REALM"
                FCB CURSAB,$23,$38,1
                FCC "OF THE STARGATE IMMORTALS"
NOWSUB:         FCB CURSAB,$2D,$58,0
                FCC "ENTER YOUR INITIALS"
                FCB COLON,SUB
                FDB TELSUB
                FCB 0

NOWMSP:         FCB COLOR,$99,SUB
                FDB PRPLYR
                FCB ZBLANK,NUMB
                FCB CURSAB,$45,$64,0
                FCC "ALSO"
                FCB SUB
                FDB NOWSUB
                FCB 0

HSTBMP:         FCB COLOR,$11,CURSAB,$3D,$3A,0
                FCC "IMMORTALS"
                FCB CURSAB,$40,$C0,0
                FCC "MORTALS"
                FCB 0

HSINDP:         FCB SBLANK,NUMB,RPAREN,SPACE,SPACE,0

HIGH1P:         FCB SBLANK,NUMY,0

HIGH3P:         FCB CURSOR,$8,0,0,SBLANK,NUMY,0

REPMSP:         FCB SBLANK,NUMB
                FCC "000"
                FCB 0

REPREP:         FCB SBLANK,NUMB
                FCC "000  "
                FCB SUB
                FDB RECS1
                FCB 0

SPSUB:          FCB CURSOR,8,0,0                  ; Move 8 full bytes to the right
                FCB 0

RECS1:          FCC "RECOMMENDED"
                FCB 0

RECS2:          FCB SUB
                FDB SPSUB
                FCB SUB
                FDB RECS1
                FCB 0

NOMESP:         FCB SBLANK,NUMB,0

HIVOLP:         FCB SUB
                FDB SVSUB
                FCC "HIGH VOLUME ARCADES"
                FCB 0

RECOMP:         FCB SBLANK,NUMB,SUB
                FDB RECS2
                FCB 0

POORPP:         FCB SUB
                FDB SVSUB
                FCC "FOR WEAKER PLAYERS"
                FCB 0

CUSTMP:         FCB SUB
                FDB SVSUB
                FCC "CUSTOM "
                FCB HYPHEN,SPACE,LPAREN
                FCC "ADJUST BELOW"
                FCB RPAREN,0

YES1MP:         FCC "YES"
                FCB SUB
                FDB SPSUB
                FCB CURSOR,-2,0,0                 ; Allow for extra letter 'S'
                FCC "ADVANCE TO ACTIVATE"
                FCB 0

SVSUB:          FCB SBLANK,NUMB,SUB
                FDB SPSUB
                FCB 0

YESMP:          FCC "YES"
                FCB 0

NOMP:           FCC "NO"
                FCB 0


EXLIBP:         FCB SUB
                FDB EXSBB
                FCB SUB
                FDB LIBS
                FCB 0

EXSBB:          FCB SUB
                FDB SVSUB
                FCC "EXTRA "
                FCB 0

LIBS:           FCC "LIBERAL"
                FCB 0

LIBP:           FCB SUB
                FDB SVSUB
                FCB SUB
                FDB LIBS
                FCB 0

MODP:           FCB SUB
                FDB SVSUB
                FCC "MODERATE"
                FCB 0

CONSP:          FCB SUB
                FDB SVSUB
                FCB SUB
                FDB CONSUB
                FCB 0

CONSUB:         FCC "CONSERVATIVE"
                FCB 0

EXCONP:         FCB SUB
                FDB EXSBB
                FCB SUB
                FDB CONSUB
                FCB 0

NOREPP:         FCB SUB
                FDB SVSUB
                FCC "NO EXTRA SHIPS"
                FCB 0

COIN1P:         FCB SUB
                FDB SVSUB
                FCC "1"
                FCB SLASH
                FCC "FIFTY  3"
                FCB SLASH
                FCC "DOLLAR"
                FCB 0

COIN2P:         FCB SUB
                FDB SVSUB
                FCC "1"
                FCB SLASH
                FCC "1 DM  6"
                FCB SLASH
                FCC "5 DM"
                FCB 0

COIN3P:         FCB SUB
                FDB SVSUB
                FCC "1"
                FCB SLASH
                FCC "QUARTER  4"
                FCB SLASH
                FCC "DOLLAR"
                FCB 0

COIN4P:         FCB SUB
                FDB SVSUB
                FCC "1"
                FCB SLASH
                FCC "2 F  3"
                FCB SLASH
                FCC "5 F"
                FCB 0

COIN5P:         FCB SUB
                FDB SVSUB
                FCC "1"
                FCB SLASH
                FCC "FIFTY  2"
                FCB SLASH
                FCC "DOLLAR"
                FCB 0

COIN6P:         FCB SUB
                FDB SVSUB
                FCC "1"
                FCB SLASH
                FCC "25  4"
                FCB SLASH
                FCC "1 G"
                FCB 0

COIN7P:         FCB SUB
                FDB SVSUB
                FCC "1"
                FCB SLASH
                FCC "5 F  2"
                FCB SLASH
                FCC "10 F"
                FCB 0

COIN8P:         FCB SUB
                FDB SVSUB
                FCC "1"
                FCB SLASH
                FCC "10 F"
                FCB 0

NO2CP:          FCB SUB
                FDB SVSUB
                FCC "NO 2"
                FCB SUB
                FDB SHIP2
                FCB 0

CMIMEP:         FCB COLOR,$22,CURSAB,$30,$80,0
                FCC "ADJUSTMENT FAILURE"
                FCB CURSAB,$20,$A0,0
                FCC "RESTORE"
                FCB SUB
                FDB FACSUB
                FCC "BY"
                FCB CURSAB,$20,$B0,0,SUB
                FDB CMISUB
                FCB COKSUB
                FDB CMICOK
                FCB CURSAB,$20,$C0,0
                FCC "AND TURNING GAME OFF AND ON"
                FCB 0

FACSUB:         FCC " FACTORY SETTINGS "
                FCB 0

RESMSP:         FCB COLOR,$99,CURSAB,$21,$80,0,SUB
                FDB FACSUB
                FCC " RESTORED"
                FCB 0

CMISUB:         FCC "OPENING FRONT DOOR"
                FCB 0

