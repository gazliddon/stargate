;; =============================================================================
;; STARGATE (1981 Williams Electronics)
;; Main Assembly
;; =============================================================================

;; System Definitions & Memory Map
                include "system/macros.gazm"
                include "system/memory.gazm"
                include "system/hw.gazm"
                include "system/header.gazm"

;; Core Game Engine
                include "core/main.gazm"
                include "core/objects.gazm"

;; Warp Sequence & Stargate Effects
                include "effects/warp.gazm"
                include "effects/planet_blowup.gazm"
                scope root

;; Game Modules, Enemies, UI & Diagnostics
                include "enemies/yllabians.gazm"
                include "core/terrain.gazm"
                include "ui/scanner_msg.gazm"
                include "enemies/baiters.gazm"
                include "enemies/landers.gazm"
                include "core/inputs.gazm"
                include "ui/text.gazm"
                include "core/explosions.gazm"
                include "enemies/dynamos.gazm"
                include "attract/attract.gazm"
                include "attract/hall_of_fame.gazm"
                include "system/audit_menu.gazm"
                include "attract/high_scores.gazm"
                include "system/diagnostics.gazm"

;; Byte Match Fixups
                include "system/fixups.gazm"

;; =============================================================================
;; Write ROM Images
;; =============================================================================
                writebin "$(OUT_DIR)/01", stargate_rom_1,  $1000
                writebin "$(OUT_DIR)/02", stargate_rom_2,  $1000
                writebin "$(OUT_DIR)/03", stargate_rom_3,  $1000
                writebin "$(OUT_DIR)/04", stargate_rom_4,  $1000
                writebin "$(OUT_DIR)/05", stargate_rom_5,  $1000
                writebin "$(OUT_DIR)/06", stargate_rom_6,  $1000
                writebin "$(OUT_DIR)/07", stargate_rom_7,  $1000
                writebin "$(OUT_DIR)/08", stargate_rom_8,  $1000
                writebin "$(OUT_DIR)/09", stargate_rom_9,  $1000
                writebin "$(OUT_DIR)/10", stargate_rom_10, $1000
                writebin "$(OUT_DIR)/11", stargate_rom_11, $1000
                writebin "$(OUT_DIR)/12", stargate_rom_12, $1000
