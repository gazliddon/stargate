; <<<<<  Stargate  >>>>>

                ORG BPSORG

UFOST:          jmp UFOST_
PRBST:          jmp PRBST_
MMSW:           jmp MMSW_
RIPV1:          jmp RIPST_
MPROB:          jmp MPROB_
BMSTV:          jmp BMST
BAITPV:         FDB UFNP1
BREDPV:         FDB BMRP0
PHRDPV:         FDB BMSP0
MCHYPV:         FDB MCHYP0
MCHRPV:         FDB MCHRP0
MCHGPV:         FDB MCHGP0

;;; __Proc__: ufo process start
;;;
;;;  * PD  : object
;;;  * PD2 : shot timer
;;;  * Pd5 : 18 frame (3 X 6) velocity divider
;;;  * Pd4 : counts number of iters left in image loop
UFOST_:         lda SEED                          ; Start baiter master????
                cmpa #$C0
                lbls BMST

// Request A UFO
// proc addr = UFOLP
// obj pic = UFNP1
// kill routine = UFOKIL
// blip col = $3333
                MKPROB(UFOLP,UFNP1,UFOKIL,$3333)
                beq !exit                         ; No procs / objs available

// Woo! Made one, increase the global number of UFOs
                inc UFOCNT
                lda #3                            ; Initialize velocity divider
                sta proc.d5,u
                ldd SEED
                anda #$1F
                addd BGL
                std OX16,x
                lsrb
                addb #YMIN
                stb OY16,x
                lda #8
                sta proc.d2,u                     ; Init shot timer
                bsr UFONV0
                jmp APVCT
!exit:          rts

;;; Ufo process
UFOLP:          ldx proc.data,u
                ldd OPICT,x
                cmpd #NULOB
                beq UFO4
                dec proc.d2,u
                bne UFO1
                lda UFSTIM
                jsr RMAX
                sta proc.d2,u
                jsr SHOOTV
                beq UFO1
                ldd #USHSND
                jsr SNDLD
UFO1:           dec proc.d5,u                     ; Call velocity subroutine only on 1 of 3 trips (18 fr)
                bne UFO2                          ; Not this time
                lda #3                            ; Reset divider
                sta proc.d5,u
                bsr UFONV                         ; And do the velocity number
UFO2:           ldd OBJX,x                        ; See if on screen
                beq UFO4                          ; Then take A very long snooze
                lda #6
                sta proc.d4,u
UFO5:
                SLEEP(1)
UFO3:           ldx proc.data,u                   ; Get image
                bsr UFOPIC                        ; And do the image number
                dec proc.d4,u
                bne UFO5                          ; 1 More iteration
                bra UFOLP
UFO4:
                NAP (6,UFOLP)

UFOPIC:         ldy OPICT,x                       ; Get current image
                leay OBJL,y                       ; Push to next
                cmpy #UFNP7                       ; Past last??
                bls UFOPL1                        ; Nope
                ldy #UFNP1                        ; Then put first in
UFOPL1:         sty OPICT,x                       ; And set in place
                rts                               ; Kay.bye

;;; Ufo velocity
;;; Ufo may seek player depending on ufosk
;;; Ufosk is set according to the wave data
UFONV:          lda SEED
                cmpa UFOSK
                bls UFONVX

;;; Makes the ufo seek the player
UFONV0:
                ldd #$4001
                std XTEMP
                ldd OX16,x
                subd PLABX
                bmi UFONV1
                neg XTEMP
UFONV1:         addd #20*32                       ; X close?
                cmpd #40*32
                bls UFONV3                        ; Yes, dont seek
                ldb XTEMP
                sex
                addd PLAXV
                std OXV,x
UFONV3:         lda OY16,x
                suba PLAYC
                bmi UFONV4
                neg XTEMP+1
UFONV4:         adda #10
                cmpa #20                          ; Y close?
                bls UFONVX                        ; Yes, quit
                clrb
                lda XTEMP+1
                addd PLAYV
                asra                              ; Divide    by 2
                rorb
                std OYV,x
UFONVX:         rts

;;; Ufokill
UFOKIL:         dec UFOCNT
                KILP ($120,UFHSND)
                rts

;;; Make a process+object
;;; Ret=process,ret+2=object pict,ret+4=coll routine,ret+6=blip
;;; U returned with process, X=object
;;; X-PD,U                                         ;0-oxv,X oyv,X
;;; Ret eq if nothing left
MPROB_:         pshs d,y
// quit if there are no procs or objs on the free list
                ldx OFREE
                beq !error                        ; None left
                ldx FREE
                beq !error

// Okay! Make a proc
                clra                              ; User type = 0
                ldu 4,s                           ; User stack -> at passed params
                pulu x                            ; X -> run process routine
                jsr MKPROC                        ; X -> proc data
                leay ,x                           ; Y -> proc


// Okay! Lets make an object!
                jsr GETOB                         ; X -> object
                pulu d                            ; Copy the pic param into the object struct
                std OPICT,x
                pulu d                            ; Copy collission parm into the object struct
                std OCVECT,x
                pulu d
                std OBJCOL,x                      ; Object blip
                stu 4,s                           ; New ret addr

// U -> proc
                leau ,y
                stu OBJID,x                       ; Save the process ptr into the objid

// Save the object ptr into the proc
                stx proc.data,u

// x -> object
                clra
                clrb
                std OYV,x                         ; Zero the obj vels
                std OXV,x

                lda #1                            ; Make sure the zero flag is 1
                puls d,y,pc                       ; Return

;;; No procs left, clear up stack and return with z flag set
!error:
                ldu 4,s                           ; Clean up stack
                leau 8,u
                stu 4,s
                clra                              ; Return with z flag = 1
                puls d,y,pc

;;; Start baiter master
;;; PD=obj,PD2=image#,pd4=base image table,pd6=shot timer
BMST:
                MKPROB (BM,BMRP0,BMKIL,$3333)
                beq BMSTX
                inc BMCNT
                clr proc.d2,u
                ldd SEED
                anda #$1F
                addd BGL
                std OX16,x                        ; Init X
                lsrb
                addb #YMIN
                stb OY16,x
                lda BMSTIM
                jsr RMAX
                sta proc.d6,u
                ldy #BMPT1
                lda SEED
                anda #3                           ; Choose bm type
                bne BMST1                         ; Keep the first bomb image table
                leay >BMPT1_size,y                ; Force the 16-bit indexed form

BMST1:          sty proc.d4,u                     ; Store the selected image table
                bsr BMNV0
                jsr MCHPIC                        ; Get image
                jmp APVCT
BMSTX:          rts


;;; Baiter master process
;;; PD=obj,PD2=image#,pd4=base image table,pd6=shot timer

BM:             ldx proc.data,u
                ldd OPICT,x
                cmpd #NULOB                       ; Appearing?
                beq BMX
                lda #-1
                ldb PLAYC
                subb OY16,x
                addb #20
                cmpb #10
                bhs !BM1
                lda #-4                           ; 4X faster when close in Y
!BM1:           adda proc.d6,u
                cmpa #$FC
                blo !BM2
                jsr BMSHT
                lda BMSTIM
                ldy proc.d4,u
                cmpy #BMPT2
                bne !BM1A
                lsra                              ; More  shots for red guys
!BM1A:          jsr RMAX
!BM2:           sta proc.d6,u
                bsr BMNV                          ; Get vel+pict
                jsr MCHPIC
BMX:
                NAP(6,BM)

;;; Get bm new velocity
BMNV:           lda SEED                          ; Smart or dumb
                cmpa BMSK
                bls BMNV5
BMNV0:          ldd #$2001
                std XTEMP
                ldd OX16,x
                subd PLABX
                bmi BMNV1
                neg XTEMP
BMNV1:          addd #20*32                       ; Too close
                cmpd #40*32
                bls BMNV2                         ; Yip
                ldb XTEMP
                sex
                addd PLAXV
                std OXV,x
BMNV2:          lda OY16,x
                suba PLAYC
                suba #4
                bmi BMNV3
                neg XTEMP+1
BMNV3:          adda #10
                cmpa #20
                bls BMNV5                         ; Too close
                lda XTEMP+1
                addd PLAYV
                asra
                rorb
                std OYV,x
BMNV5:          rts

;;; Baiter master shooting
BMSHT:          pshs x,u,d,y
                lda OX16,x
                suba BGL
                cmpa #$26
                bhi BMSHTX                        ; No
                lda MCHCNT
                cmpa #12
                bhs BMSHTX
                leay ,x
                MKPROB (MCH,MCHP1,MCHKIL,$3300)   ; Launch A buttface
                beq BMSHTX                        ; Nobody home
                inc MCHCNT
                ldd #BMSSND
                jsr SNDLD
                clr proc.d2,u
                lda SEED
                anda #3
                beq BMSHT1
                deca
BMSHT1:         ldb #MCHPT2-MCHPT1
                mul
                addd #MCHPT1
                std proc.d4,u                     ; Base pict table
                ldb #$40                          ; Init xv
                jsr RMAX
                lda OX16,y
                cmpa PLABX
                bmi BMSHT2
                negb
BMSHT2:         sex
                addd PLAXV
                std OXV,x
                lda MCHSLP
                lsra
                jsr RMAX
                sta proc.d3,u
                jsr RAND
                ldb HSEED
                sex
                std OYV,x
                ldd OX16,y
                std OX16,x
                ldd OY16,y
                std OY16,x
                jsr MCHPIC                        ; Picture
                stx OPTR
BMSHTX:         puls x,u,d,y,pc

;
; Kill A munchy-pooh
;

MCHKIL:         dec MCHCNT
                KILP ($50,MCKSND)
                rts

;;; Kill baiter master
BMKIL:          dec BMCNT
                KILP ($120,BMKSND)
                rts

BMSSND:         FCB $D0,$01,$10,$18,0             ; Bm shoot snd
BMKSND:         FCB $D0,$01,$0C,$01,$1,$08,$17,0  ; Bm kill
MCKSND:         FCB $D0,$01,$0C,$1A,$1,$08,$17,0  ; Munchy kill

;;; Munchies
;;; PD=object,PD2=image#,pd3=sleep time,pd4=base image table
MCH:            ldx proc.data,u                   ; Get obj
                dec proc.d3,u
                bne !MCH10
                ldb MCHXV                         ; Calc vel limits
                clra
                pshs d
                negb
                sex
                pshs d
                lda MCHYV
                clrb
                pshs d
                nega
                pshs d
// VEL LIMITS 0,S =-YV
// 2,S =YV; 4,S =-xv; 6,S =xv
                ldd HSEED
                anda #1
                addd PLABX
                subd OX16,x
                std XTEMP                         ; Delta X
                ldd SEED
                anda #7
                addd PLAY16
                subd OY16,x
                std XTEMP2
!MCHVLP:        asr XTEMP
                ror XTEMP+1
                asr XTEMP2
                ror XTEMP2+1
                ldd XTEMP
                bpl !MCHV1
                cmpd 4,s
                blt !MCHVLP
                bra !MCHV2
!MCHV1:         cmpd 6,s
                bhi !MCHVLP
!MCHV2:         ldd XTEMP2
                bpl !MCHV3
                cmpd ,s
                blt !MCHVLP
                bra !MCHVX
!MCHV3:         cmpd 2,s
                bhi !MCHVLP
!MCHVX:         leas 8,s                          ; Clear stack
                std OYV,x
                ldd XTEMP
                addd PLAXV
                std OXV,x
                lda MCHSLP                        ; New sleep time
                jsr RMAX
                sta proc.d3,u
!MCH10:         bsr MCHPIC
                NAP (6,MCH)

;;; Get munchy picture
;;; X=obj,U=process
;;; PD2=image#,pd4=base image
MCHPIC:         pshs d,y
                lda proc.d2,u                     ; Get image #
                inca
                ldb OXV,x
                bmi MCHP1                         ; Check dir
                cmpa #2
                bls MCHP2
                clra
                bra MCHP2
MCHP1:          cmpa #5
                bhi MCHP11
MCHP10:         cmpa #3
                bhs MCHP2
MCHP11:         lda #3
MCHP2:          sta proc.d2,u
                ldy proc.d4,u
                asla
                ldd a,y
                std OPICT,x
                puls d,y,pc

; Baiter master picture tables
BMPT1:          FDB BMRP0,BMRP1,BMRP2,BMRP0,BMRP3,BMRP4  ; Round bm
BMPT1_size:     equ 12
BMPT2:          FDB BMSP0,BMSP1,BMSP2,BMSP0,BMSP3,BMSP4  ; Square bm

; Munchy pict tables
MCHPT1:         FDB MCHGP0,MCHGP1,MCHGP2,MCHGP0,MCHGP3,MCHGP4  ; Green
MCHPT2:         FDB MCHRP0,MCHRP1,MCHRP2,MCHRP0,MCHRP3,MCHRP4  ; Red
MCHPT3:         FDB MCHYP0,MCHYP1,MCHYP2,MCHYP0,MCHYP3,MCHYP4  ; Yellow

;
; Munchy picts
