.P1SBC:         RMB 1                             ; Smart bombs
.P1INV:         RMB 1                             ; Inviso timer
.P1TRG:         RMB 1                             ; Astronauts
.P1ENM:         RMB 50                            ; Enemy state
.P1END:

.P2SCR:         RMB 4
.P2RP:          RMB 4
.P2LAS:         RMB 1
.P2WAV:         RMB 1
.P2SBC:         RMB 1
.P2INV:         RMB 1                             ; Inviso timer
.P2TRG:         RMB 1
.P2ENM:         RMB 50

PLDEND:                                           ; End of player data

