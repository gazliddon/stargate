;
; Draw border
;
BORDER:         lda SCNCOL
                ldb SCNCOL
                ldx #PLIN
BORD0:          sta ,x
                leax $100,x
                cmpx #SCANER
                blo BORD0
                ldx #P2ORG+PLIN-$100              ; Player 2 line
BORD00:         sta ,x
                leax $100,x
                cmpx #$9C00
                blo BORD00
                sta SCANER-1                      ; Scanner corners
                sta SCANER+$FF
                sta SCANER+28
                sta SCANER+$100+28
                anda #$0F
                ldx #SCANER-$100-1
BORD01:         sta ,x+
                cmpx #SCANER-$100+35
                bne BORD01
                lda SCNCOL                        ; Right corners
                ldb SCNCOL
                sta SCANER+$3F00-1
                sta SCANER+$3E00-1
                sta SCANER+$3E00+28
                sta SCANER+$3F00+28
                anda #$F0
                ldx #SCANER+$4000-1
BORD02:         sta ,x+
                cmpx #SCANER+$4009+26
                bne BORD02
                ldd #$9999
                ldx #SCANER+$1C00-2
BORD3:          std ,x
                std 30,x
                leax $100,x
                cmpx #SCANER+$2400-2
                bne BORD3
                rts
